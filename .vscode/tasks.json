{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Local CORS Proxy",
      "type": "shell",
      "command": "node server.js",
      "options": {
        "cwd": "${workspaceFolder}/local-proxy"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "CORS proxy listening",
          "endsPattern": "CORS proxy listening"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      }
    }
    ,
    {
      "label": "Publish to gh-pages",
      "type": "shell",
      "command": "git rev-parse --abbrev-ref HEAD | xargs -I{} sh -c 'git checkout gh-pages && git merge {} --no-edit && git push origin gh-pages && git checkout {}'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      }
    }
  ]
}
